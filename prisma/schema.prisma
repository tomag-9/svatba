generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum GuestAttendance {
  NO
  MAYBE
  YES
}

enum WeddingRole {
  TOMI
  ANGIE
}

model WeddingSettings {
  id                  String       @id @default(cuid())
  weddingDate         DateTime?
  weddingDateApproximate Boolean   @default(false)
  budgetTarget        Decimal?     @db.Decimal(12, 2)
  currency            String       @default("EUR")
  venueName           String?
  role                WeddingRole   @default(TOMI)
  deadlineAlertsEnabled Boolean     @default(false)
  alertLeadDays       Int          @default(3)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model PushSubscription {
  id             String   @id @default(cuid())
  endpoint       String   @unique
  p256dh         String
  auth           String
  expirationTime Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  notes       String?
  resultInfo  String?
  deadline    DateTime?
  priority    TaskPriority  @default(MEDIUM)
  status      TaskStatus    @default(TODO)
  category    String?
  phase       String?
  assignee    String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([deadline])
  @@index([priority])
  @@index([status])
}

model Guest {
  id          String          @id @default(cuid())
  name        String
  familyGroup String?
  attendance  GuestAttendance  @default(MAYBE)
  dinner      Boolean         @default(false)
  party       Boolean         @default(false)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Expense {
  id             String   @id @default(cuid())
  title          String
  category       String?
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("EUR")
  isPaid         Boolean  @default(false)
  expectedPaidOn DateTime?
  vendor         String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([isPaid])
}
